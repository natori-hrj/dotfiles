{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "dynamic-island",
    "layout": {
      "left": [
        {
          "id": "donovan.workspaces"
        },
        {
          "id": "crmne.active-window"
        }
      ],
      "center": [
        {
          "id": "dynamic-island",
          "type": "qml"
        }
      ],
      "right": [
        {
          "id": "meviusisback.agent-orchestr"
        },
        {
          "id": "crmne.mpris"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "natori.notifications"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer"
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ]
}
