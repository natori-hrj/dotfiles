{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "layout": {
      "left": [
        {
          "id": "donovan.workspaces"
        },
        {
          "id": "crmne.active-window"
        }
      ],
      "center": [],
      "right": [
        {
          "id": "meviusisback.agent-orchestr"
        },
        {
          "id": "crmne.mpris"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "omarchy-dynamic-island",
      "style": "island",
      "background": "theme",
      "idle": "pill",
      "idleFace": "ticker",
      "scale": 1,
      "reserveSpace": false,
      "keybind": false,
      "monitor": "primary",
      "layer": "top",
      "expandOnHover": true,
      "clockFormat": "HH:mm",
      "mediaLingerSeconds": 30,
      "notchWidth": 0,
      "notchHeight": 0,
      "notchRadius": 0,
      "visualizerColor": "accent",
      "textFont": "theme",
      "glow": false,
      "calendars": [],
      "calendarLeadMinutes": 15,
      "holidays": "auto",
      "timerSound": true,
      "bluetooth": true,
      "camera": true,
      "calendar": true,
      "notifications": true,
      "inbox": true,
      "osd": true,
      "volume": true,
      "brightness": true,
      "charging": true,
      "trackChange": true,
      "recording": true,
      "mic": true,
      "topMargin": 6
    },
    {
      "id": "natori.pdf-library"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "my-natori-glass",
      "avatar": "/home/natori/Downloads/profile.jpg"
    }
  ],
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.notifications",
    "omarchy.osd"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ]
}
