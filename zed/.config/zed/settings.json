// Zed settings
//
// The colors below follow the active Omarchy Vantablack palette.
{
  "terminal": {
    "dock": "right"
  },
  "project_panel": {
    "dock": "left"
  },
  "pane_split_direction_vertical": "right",
  "tabs": {
    "close_position": "right",
    "git_status": false
  },
  "title_bar": {
    "show_menus": false
  },
  "status_bar": {
    "show_active_file": true
  },
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "vim_mode": false,
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "theme_overrides": {
    "One Dark": {
      "border": "#1a1a1a",
      "border.variant": "#090909",
      "border.focused": "#8d8d8d",
      "border.selected": "#1a1a1a",
      "border.disabled": "#1a1a1a",
      "elevated_surface.background": "#090909",
      "surface.background": "#090909",
      "background": "#070707",
      "element.background": "#090909",
      "element.hover": "#1a1a1a",
      "element.active": "#1a1a1a",
      "element.selected": "#1a1a1a",
      "element.disabled": "#090909",
      "ghost_element.hover": "#1a1a1a",
      "ghost_element.active": "#1a1a1a",
      "ghost_element.selected": "#1a1a1a",
      "ghost_element.disabled": "#090909",
      "text": "#ffffff",
      "text.muted": "#b6b6b6",
      "text.placeholder": "#7a7a7a",
      "text.disabled": "#7a7a7a",
      "text.accent": "#8d8d8d",
      "icon": "#ffffff",
      "icon.muted": "#b6b6b6",
      "icon.disabled": "#7a7a7a",
      "icon.placeholder": "#b6b6b6",
      "icon.accent": "#8d8d8d",
      "status_bar.background": "#070707",
      "title_bar.background": "#070707",
      "title_bar.inactive_background": "#090909",
      "toolbar.background": "#000000",
      "tab_bar.background": "#090909",
      "tab.inactive_background": "#090909",
      "tab.active_background": "#000000",
      "search.match_background": "#8d8d8d66",
      "search.active_match_background": "#cecece66",
      "panel.background": "#090909",
      "scrollbar.thumb.background": "#7a7a7a66",
      "scrollbar.thumb.hover_background": "#1a1a1a",
      "scrollbar.thumb.border": "#1a1a1a",
      "scrollbar.track.border": "#090909",
      "editor.foreground": "#ececec",
      "editor.background": "#000000",
      "editor.gutter.background": "#000000",
      "editor.subheader.background": "#090909",
      "editor.active_line.background": "#090909bf",
      "editor.highlighted_line.background": "#090909",
      "editor.line_number": "#505050",
      "editor.active_line_number": "#ffffff",
      "editor.hover_line_number": "#b6b6b6",
      "editor.invisible": "#505050",
      "editor.wrap_guide": "#7a7a7a0d",
      "editor.active_wrap_guide": "#7a7a7a1a",
      "editor.document_highlight.read_background": "#8d8d8d1a",
      "editor.document_highlight.write_background": "#7a7a7a40",
      "terminal.background": "#000000",
      "terminal.foreground": "#ffffff",
      "terminal.bright_foreground": "#ffffff",
      "terminal.dim_foreground": "#7a7a7a",
      "terminal.ansi.black": "#000000",
      "terminal.ansi.bright_black": "#7a7a7a",
      "terminal.ansi.dim_black": "#090909",
      "terminal.ansi.red": "#a4a4a4",
      "terminal.ansi.bright_red": "#a4a4a4",
      "terminal.ansi.dim_red": "#5c5c5c",
      "terminal.ansi.green": "#b6b6b6",
      "terminal.ansi.bright_green": "#b6b6b6",
      "terminal.ansi.dim_green": "#7a7a7a",
      "terminal.ansi.yellow": "#cecece",
      "terminal.ansi.bright_yellow": "#cecece",
      "terminal.ansi.dim_yellow": "#7a7a7a",
      "terminal.ansi.blue": "#8d8d8d",
      "terminal.ansi.bright_blue": "#8d8d8d",
      "terminal.ansi.dim_blue": "#5c5c5c",
      "terminal.ansi.magenta": "#9b9b9b",
      "terminal.ansi.bright_magenta": "#9b9b9b",
      "terminal.ansi.dim_magenta": "#5c5c5c",
      "terminal.ansi.cyan": "#b0b0b0",
      "terminal.ansi.bright_cyan": "#b0b0b0",
      "terminal.ansi.dim_cyan": "#7a7a7a",
      "terminal.ansi.white": "#ffffff",
      "terminal.ansi.bright_white": "#ffffff",
      "terminal.ansi.dim_white": "#b6b6b6",
      "link_text.hover": "#8d8d8d",
      "version_control.added": "#b6b6b6",
      "version_control.modified": "#cecece",
      "version_control.word_added": "#b6b6b640",
      "version_control.word_deleted": "#a4a4a440",
      "version_control.deleted": "#a4a4a4",
      "conflict": "#cecece",
      "created": "#b6b6b6",
      "deleted": "#a4a4a4",
      "error": "#a4a4a4",
      "hidden": "#7a7a7a",
      "hint": "#7a7a7a",
      "ignored": "#7a7a7a",
      "info": "#8d8d8d",
      "modified": "#cecece",
      "predictive": "#7a7a7a",
      "renamed": "#8d8d8d",
      "success": "#b6b6b6",
      "unreachable": "#7a7a7a",
      "warning": "#cecece",
      "syntax": {
        "attribute": { "color": "#8d8d8d" },
        "boolean": { "color": "#cecece" },
        "comment": { "color": "#7a7a7a" },
        "comment.doc": { "color": "#b6b6b6" },
        "constant": { "color": "#cecece" },
        "constructor": { "color": "#8d8d8d" },
        "embedded": { "color": "#ececec" },
        "emphasis": { "color": "#8d8d8d" },
        "emphasis.strong": { "color": "#cecece" },
        "enum": { "color": "#b0b0b0" },
        "function": { "color": "#8d8d8d" },
        "hint": { "color": "#7a7a7a" },
        "keyword": { "color": "#9b9b9b" },
        "label": { "color": "#8d8d8d" },
        "link_text": { "color": "#8d8d8d" },
        "link_uri": { "color": "#b0b0b0" },
        "namespace": { "color": "#ffffff" },
        "number": { "color": "#cecece" },
        "operator": { "color": "#b0b0b0" },
        "predictive": { "color": "#7a7a7a" },
        "preproc": { "color": "#9b9b9b" },
        "primary": { "color": "#ececec" },
        "property": { "color": "#a4a4a4" },
        "punctuation": { "color": "#ececec" },
        "punctuation.bracket": { "color": "#b0b0b0" },
        "punctuation.delimiter": { "color": "#b0b0b0" },
        "punctuation.list_marker": { "color": "#a4a4a4" },
        "punctuation.markup": { "color": "#a4a4a4" },
        "punctuation.special": { "color": "#5c5c5c" },
        "selector": { "color": "#cecece" },
        "selector.pseudo": { "color": "#8d8d8d" },
        "string": { "color": "#b6b6b6" },
        "string.escape": { "color": "#7a7a7a" },
        "string.regex": { "color": "#cecece" },
        "string.special": { "color": "#cecece" },
        "string.special.symbol": { "color": "#cecece" },
        "tag": { "color": "#8d8d8d" },
        "text.literal": { "color": "#b6b6b6" },
        "title": { "color": "#ffffff" },
        "type": { "color": "#b0b0b0" },
        "variable": { "color": "#ececec" },
        "variable.parameter": { "color": "#a4a4a4" },
        "variable.special": { "color": "#cecece" },
        "variant": { "color": "#8d8d8d" },
        "diff.plus": { "color": "#b6b6b6" },
        "diff.minus": { "color": "#a4a4a4" }
      }
    }
  }
}
